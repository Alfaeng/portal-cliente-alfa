# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# String longa e aleatória usada para assinar o cookie de sessão do
# portal do cliente (login por CPF). Gere com: openssl rand -base64 48
SESSION_SECRET=gere-uma-string-aleatoria-longa-aqui

# URL pública do site em produção (usada nos links de convite/redefinição
# de senha dos admins). Em desenvolvimento local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
